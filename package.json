{
  "name": "mcr-asesores-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "vinext build && node scripts/prepare-sites-build.mjs",
    "build:pages": "next build",
    "start": "next start",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.3",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.30",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.3",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "type": "module"
}
